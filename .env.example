# Docker Compose reads this root file. Never commit a real .env.
# Use a long random password without URL-reserved characters for this example URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ENV=production
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=3
TASK_LEASE_SECONDS=300
WORKER_POLL_SECONDS=2
# Optional official Feishu application token with access to the chosen table.
FEISHU_ACCESS_TOKEN=
SOURCE_FETCH_ALLOWED_HOSTS=["open.feishu.cn"]
# External email submission is disabled until configured explicitly.
EMAIL_SUBMIT_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_RECIPIENT_ALLOWLIST=
